# URL ของ backend ตอน deploy (ไม่ต้องมี / ปิดท้าย) เช่น https://cactus-api.onrender.com
# ตอน dev ปล่อยว่างไว้ได้ เพราะ vite proxy /api ไป localhost:4000 ให้แล้ว
VITE_API_URL=

# กล่องแชตกับบอท (คุยผ่าน backend → Botnoi Custom Channel) ใส่ off เพื่อปิด
# VITE_CHAT=off
# VITE_BOTNOI_BOT_LOGO=https://...
